`timescale 1 ps/ 1 ps
module FIP_tst();

	reg clk;
	reg [63:0] hdm_data;
	reg hdm_valid;
	reg last_data;
	reg rst_n;
																 
	wire [63:0]  acc_result;
	wire acc_valid;
	wire fip_ready;
	//data
	reg [63:0] tst_data [15:0];
	reg [23:0] valid;
	//testbench signal
	reg [2:0] out_cnt;
	reg [3:0] dat_cnt;		
			
	FIP i1 ( 
		.acc_result(acc_result),
		.acc_valid(acc_valid),
		.clk(clk),
		.fip_ready(fip_ready),
		.hdm_data(hdm_data),
		.hdm_valid(hdm_valid),
		.last_data(last_data),
		.rst_n(rst_n)
	);
	
	integer i;
	
	initial begin //test data
		tst_data[0] = 64'h0000_0000_0000_0001;
		for(i = 1; i< 16; i = i+1 )begin
			tst_data[i] = tst_data[i-1] << 4;
		end
	end
	
	initial begin
		valid = 24'b0111_1111_1111_1111_0011_1010;
		
		clk = 1'b0;
		rst_n = 1'b0;
		hdm_data = 64'd0;
		hdm_valid = 1'b0;
		last_data = 1'b0;
		
		out_cnt = 3'd0;
		dat_cnt = 4'd0;
		
		#10 rst_n = 1'b1;
	end

	always #5 clk = ~clk;
	
	always @(posedge clk)begin
		if(fip_ready && hdm_valid && rst_n)begin
			out_cnt <= out_cnt + 3'd1;
			dat_cnt <= dat_cnt + 4'd1;
		end
	end
	
	always @(*) hdm_data = tst_data[dat_cnt];
	
	always @(*)begin
		last_data = out_cnt == 3'd7;
	end

	always @(posedge clk)begin
		if(rst_n)begin
			hdm_valid <= valid[0];
			valid <= valid >> 1;
		end
	end

endmodule

