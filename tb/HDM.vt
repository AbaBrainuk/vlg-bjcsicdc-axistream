`timescale 1 ps/ 1 ps
module HDM_tst();

	reg rst_n;
	reg clk;

	reg clac_start;//上个模块输入
	reg last_ele;
	reg [63:0] tile_data;
	reg [31:0] tile_id;
	reg tile_valid;

	wire fip_ready;
	wire [63:0]  hdm_data;
	wire hdm_valid;
	wire last_data;//连接

	wire hdm_ready;//本模块输出

	wire [63:0]  acc_result;//下个模块输出
	wire acc_valid;

	//data
	reg [63:0] tst_data [31:0];
	reg [35:0] valid;
	//testbench signal
	reg [3:0] out_cnt;
	reg [4:0] dat_cnt;
	reg [7:0] all_cnt;
	
	HDM i1 (
		.clac_start(clac_start),
		.clk(clk),
		.fip_ready(fip_ready),
		.hdm_data(hdm_data),
		.hdm_ready(hdm_ready),
		.hdm_valid(hdm_valid),
		.last_data(last_data),
		.last_ele(last_ele),
		.rst_n(rst_n),
		.tile_data(tile_data),
		.tile_id(tile_id),
		.tile_valid(tile_valid)
	);

	FIP i2 ( 
			.acc_result(acc_result),
			.acc_valid(acc_valid),
			.clk(clk),
			.fip_ready(fip_ready),
			.hdm_data(hdm_data),
			.hdm_valid(hdm_valid),
			.last_data(last_data),
			.rst_n(rst_n)
	);

	integer i;
	
	initial begin //test data
		tst_data[0] = 64'h0000_0000_0000_0001;
		for(i = 1; i< 16; i = i+1 )begin
			tst_data[i] = tst_data[i-1] << 4;
		end
		for(i = 16; i< 32; i = i+1 )begin
			tst_data[i] = tst_data[i-1] >> 4;
		end
	end


	initial begin
		valid = 36'b0011_1111_1111_1111_1101_1111_1111_1111_1110;
		
		clk = 1'b0;
		rst_n = 1'b0;
		
		clac_start = 1'b0;
		last_ele = 1'b0;
		tile_data = 64'd0;
		tile_id = 32'd0;
		tile_valid = 1'b0;
		
		out_cnt = 4'd0;
		dat_cnt = 5'd0;
		all_cnt = 8'd0;
		
		#10 rst_n = 1'b1;
	end

	always #5 clk = ~clk;

	always @(posedge clk)begin
		if(hdm_ready && tile_valid && rst_n)begin
			out_cnt <= out_cnt + 4'd1;
			dat_cnt <= dat_cnt + 5'd1;
		end
	end
	
	always @(*) begin
		if ( all_cnt == 8'd0)
			tile_id = 32'd1;
		else if (all_cnt == 8'd18)
			tile_id = 32'd0;
			
		clac_start = all_cnt == 8'd35;
		tile_data = tst_data[dat_cnt];
		
	end
	
	
	
	always @(*)begin
		last_ele = out_cnt == 4'd15;
	end

	always @(posedge clk)begin
		if(rst_n)begin
			all_cnt <= all_cnt + 8'd1;
			tile_valid <= valid[0];
			valid <= valid >> 1;
		end
	end

endmodule

module FIP(
	input clk,
	input rst_n,
	input [63:0] hdm_data,
	input last_data,
	input hdm_valid,
	output fip_ready,
	output reg acc_valid,
	output reg [63:0] acc_result
);
	localparam sReady = 0,sDone = 1;

	reg [1:0] s,ns;
	reg [63:0] local_result;
	always @(*)begin//状态转移
		case(s)
			sReady:ns = (last_data & hdm_valid)?sDone : sReady;
			sDone:ns = sReady;
		endcase
	end
	
	
	
	always @(posedge clk)begin//状态流与数据流
		if(~rst_n)begin
			local_result <= 64'd0;
			s <= sReady;
		end else begin 
			s <= ns;
			if(hdm_valid) begin
				local_result <= local_result + hdm_data;
			end
			if(s == sDone)begin
				local_result <= 64'd0;
			end
		end
	end
	
	always @(posedge clk)begin//输出流
		if(~rst_n)begin
			acc_result <= 64'd0;
			acc_valid <= 1'b0;
		end else begin 
			if(s == sDone) begin
				acc_result <= local_result;
				acc_valid <= 1'b1;
			end
		end
	end

	assign fip_ready = s == sReady;
endmodule